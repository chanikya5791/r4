KAFKA_BROKERS=localhost:9094
KAFKA_CLIENT_ID=shoplite-jobs
KAFKA_GROUP_ID=shoplite-jobs
# Same Postgres database the Orders API uses
DATABASE_URL=postgres://shoplite:shoplite@localhost:5432/orders
# Same MongoDB database the Catalog API uses
MONGO_URL=mongodb://localhost:27017
MONGO_DB=catalog
HEALTH_PORT=3004
# Attempts per message before it goes to the <topic>.dlq topic
MAX_ATTEMPTS=3
RETRY_BACKOFF_MS=500
# Wait before processing each new order, so PENDING is visible in the UI (0 = no wait)
PROCESSING_DELAY_MS=0
# How often to rebuild today's summary (0 = never; use npm run job:summary instead)
SUMMARY_INTERVAL_MS=60000
