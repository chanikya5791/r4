{
  "name": "shoplite-jobs",
  "version": "1.0.0",
  "private": true,
  "description": "ShopLite jobs worker: consumes order events from Kafka, reserves stock in MongoDB, updates order status in Postgres and builds daily summaries",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "job:summary": "node dist/cli/summary.js",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "kafkajs": "^2.2.4",
    "mongodb": "^6.22.0",
    "pg": "^8.23.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@testcontainers/mongodb": "^10.28.0",
    "@testcontainers/postgresql": "^10.28.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "testcontainers": "^10.28.0",
    "tsx": "^4.23.15",
    "typescript": "5.6",
    "vitest": "^2.1.9"
  }
}
